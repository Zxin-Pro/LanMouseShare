<?xml version="1.0" encoding="utf-8"?>
<!--
  这一行不是装饰：
  在没装 .NET Framework 4.8 的 Windows 7 SP1 上运行本程序时，
  Windows 会读取这里的 sku，弹出系统自带的
  「此应用程序需要以下版本的 .NET Framework: v4.8」对话框，
  对话框上的「是」会直接把你带到微软官方下载页。
  没有这一段，用户只会看到一句毫无信息的报错。
-->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>

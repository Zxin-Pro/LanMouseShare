<Window x:Class="LanMouseShare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LanMouseShare · 局域网键鼠共享"
        Height="740" Width="980" MinHeight="620" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="#FFF3F5F8"
        FontFamily="Microsoft YaHei, Segoe UI"
        FontSize="13"
        Icon="pack://application:,,,/Assets/app.ico"
        Closing="OnWindowClosing">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#FFE1E6ED" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF6B7A8D" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF2E7CF6" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF1F2A37" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF1F2A37" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="#FF2E7CF6">
                    <TextBlock Text="LM" Foreground="White" FontWeight="Bold" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" Text="LanMouseShare" Foreground="White"
                               FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeaderSubtitle" Foreground="#FFB9C4D2" FontSize="12"
                               Text="一套鼠标键盘，两台电脑；从屏幕边缘直接划过去即可切换" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="PillRole" Background="#FF33415A" CornerRadius="10" Padding="10,4" Margin="0,0,6,0">
                        <TextBlock x:Name="PillRoleText" Foreground="White" FontSize="12" Text="未启动" />
                    </Border>
                    <Border x:Name="PillConn" Background="#FF33415A" CornerRadius="10" Padding="10,4" Margin="0,0,6,0">
                        <TextBlock x:Name="PillConnText" Foreground="White" FontSize="12" Text="未连接" />
                    </Border>
                    <Border x:Name="PillCursor" Background="#FF33415A" CornerRadius="10" Padding="10,4">
                        <TextBlock x:Name="PillCursorText" Foreground="White" FontSize="12" Text="光标：本机" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#FFE9EDF3" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterStatus" Grid.Column="0" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" Text="就绪" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="最小化到托盘" Style="{StaticResource PlainButton}" Click="OnHideClick" Margin="0,0,8,0" />
                    <Button Content="退出" Style="{StaticResource PlainButton}" Click="OnExitClick" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Margin="12,12,12,8" Background="Transparent" BorderThickness="0">

            <TabItem Header=" 共享 ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="这台电脑扮演什么角色" Style="{StaticResource SectionTitle}" />
                                <RadioButton x:Name="RoleHost" Content="主机 —— 鼠标键盘接在这台电脑上（副机的输入由它转发）"
                                             GroupName="Role" Margin="0,2,0,6" Checked="OnRoleChanged" />
                                <RadioButton x:Name="RoleClient" Content="副机 —— 这台电脑不接鼠标键盘，接收主机发来的输入"
                                             GroupName="Role" Checked="OnRoleChanged" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                           Text="提示：两台电脑都要装本软件。哪台接了鼠标键盘，哪台就是主机。角色可以随时切换。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="网络" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="TCP 端口" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="PortBox" Style="{StaticResource Input}"
                                             TextChanged="OnPortChanged" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="连接密钥" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="0" Grid.Column="4" x:Name="KeyBox" Style="{StaticResource Input}"
                                             TextChanged="OnKeyChanged" />
                                    <Button Grid.Row="0" Grid.Column="5" Content="随机" Style="{StaticResource PlainButton}"
                                            Click="OnGenerateKey" Margin="8,0,0,0" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="主机 IP" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" x:Name="PeerHostBox"
                                             Style="{StaticResource Input}" TextChanged="OnPeerHostChanged" />
                                    <Button Grid.Row="2" Grid.Column="5" Content="复制本机 IP" Style="{StaticResource PlainButton}"
                                            Click="OnFillLocalIp" Margin="8,0,0,0" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="6" Style="{StaticResource Hint}"
                                               x:Name="NetworkHint" Text="本机局域网地址：" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="共享开关" Style="{StaticResource SectionTitle}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="StartStopButton" Content="开始共享" Style="{StaticResource PrimaryButton}"
                                            Click="OnStartStopClick" MinWidth="120" />
                                    <Button x:Name="TestMoveButton" Content="测试：把副机鼠标移到 (100,100)"
                                            Style="{StaticResource PlainButton}" Click="OnSendTestMove" Margin="10,0,0,0" />
                                    <Button x:Name="ReturnButton" Content="强制鼠标回本机" Style="{StaticResource PlainButton}"
                                            Click="OnForceReturn" Margin="10,0,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="KeyboardCheck" Content="同时共享键盘（鼠标共享稳定后再开）"
                                          Margin="0,14,0,4" Checked="OnKeyboardChanged" Unchecked="OnKeyboardChanged" />
                                <CheckBox x:Name="ReconnectCheck" Content="断线后自动重连（每 3 秒重试）"
                                          Checked="OnReconnectChanged" Unchecked="OnReconnectChanged" />
                                <CheckBox x:Name="AutoStartCheck" Content="程序启动时自动开始共享"
                                          Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged" />
                                <CheckBox x:Name="UpdateOnStartCheck" Content="启动时自动检查更新"
                                          Checked="OnUpdateOnStartChanged" Unchecked="OnUpdateOnStartChanged" />
                                <TextBlock x:Name="StartStopHint" Style="{StaticResource Hint}" Margin="0,12,0,0"
                                           Text="鼠标共享的用法：把光标推到靠副机那一侧的屏幕边缘，不用按任何热键就会划到副机；从副机侧划回来即回到本机。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header=" 屏幕布局 ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="副机相对主机的位置" Style="{StaticResource SectionTitle}" />
                                <WrapPanel>
                                    <RadioButton x:Name="SideLeft" GroupName="Side" Content="左侧" Margin="0,0,18,0"
                                                 Checked="OnSideChanged" />
                                    <RadioButton x:Name="SideRight" GroupName="Side" Content="右侧" Margin="0,0,18,0"
                                                 Checked="OnSideChanged" />
                                    <RadioButton x:Name="SideAbove" GroupName="Side" Content="上方" Margin="0,0,18,0"
                                                 Checked="OnSideChanged" />
                                    <RadioButton x:Name="SideBelow" GroupName="Side" Content="下方"
                                                 Checked="OnSideChanged" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                           Text="要在副机界面上选「主机在左侧」，在主机界面上选「副机在右侧」，两边互为镜像，方向才会一致。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="对齐与防抖" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="沿边偏移 (px)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="OffsetBox" Style="{StaticResource Input}"
                                             TextChanged="OnOffsetChanged" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="回程守卫 (px)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="GuardBox" Style="{StaticResource Input}"
                                             TextChanged="OnGuardChanged" />
                                    <TextBlock Grid.Row="0" Grid.Column="4" Grid.RowSpan="3" Style="{StaticResource Hint}"
                                               Margin="16,0,0,0"
                                               Text="偏移：沿贴合边方向把副机整体上下（左右）挪多少像素，用来对齐两台显示器桌面图标的实际高度。&#10;回程守卫：鼠标从副机划回主机时，必须在边界附近再多走这么多像素才生效，防止在边缘来回横跳。" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="布局预览" Style="{StaticResource SectionTitle}" />
                                <Canvas x:Name="LayoutPreview" Height="210" Background="#FFEDF1F6" ClipToBounds="True" />
                                <TextBlock x:Name="LayoutSummary" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header=" 键盘 ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="键盘共享状态" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="KeyboardStateText" Style="{StaticResource Hint}"
                                           Text="键盘共享开关在「共享」页。" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                           Text="原理：主机端用 WH_KEYBOARD_LL 全局钩子拦截按键，把扫描码原样发给副机，副机用 SendInput 重放。用扫描码而不是虚拟键码，是为了让游戏里读 DirectInput 的程序也能正常收到按键。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="强制返回本机" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Ctrl + Alt + Home" FontSize="20" FontWeight="SemiBold" Foreground="#FF2E7CF6" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                           Text="鼠标划到副机之后，如果副机卡住、或者想在副机上做点什么又不想碰鼠标，按 Ctrl+Alt+Home 可以把控制权强行收回本机。这个热键在主机端识别，鼠标跑到副机也能按。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="键盘共享注意事项" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="1. Ctrl+Alt+Delete 属于 Windows 安全序列，任何用户态程序都无法转发，这是系统限制。&#10;2. UAC 提权时的安全桌面同理，拦不住，看到提权窗口时请直接用本机键盘。&#10;3. 输入法（中文候选框）的状态是每台机器各自的，切到副机后用的是副机的输入法。&#10;4. 如果副机上的游戏对按键不敏感，通常是对方的键盘共享开关没打开，或者副机程序没有以管理员身份运行。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header=" 日志 ">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox x:Name="AutoScrollCheck" Content="自动滚动到最新" IsChecked="True"
                                  VerticalAlignment="Center" />
                        <Button Content="清空显示" Style="{StaticResource PlainButton}" Click="OnClearLog" Margin="16,0,0,0" />
                        <Button Content="打开日志文件" Style="{StaticResource PlainButton}" Click="OnOpenLogFile" Margin="8,0,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="8">
                        <ListBox x:Name="LogList" BorderThickness="0" FontFamily="Consolas, Microsoft YaHei"
                                 FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                    </Border>

                    <TextBlock Grid.Row="2" x:Name="LogPathText" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                </Grid>
            </TabItem>

            <TabItem Header=" 诊断与更新 ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="检查更新" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="UpdateStatusText" Text="尚未检查" Style="{StaticResource Hint}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="CheckUpdateButton" Content="立即检查更新" Style="{StaticResource PrimaryButton}"
                                            Click="OnCheckUpdateClick" />
                                    <Button Content="打开发布页面" Style="{StaticResource PlainButton}"
                                            Click="OnOpenReleases" Margin="8,0,0,0" />
                                    <Button x:Name="DownloadButton" Content="下载新版本" Style="{StaticResource PlainButton}"
                                            Click="OnDownloadUpdate" Margin="8,0,0,0" IsEnabled="False" />
                                </StackPanel>
                                <TextBox x:Name="UpdateNotesBox" Margin="0,10,0,0" Height="90" IsReadOnly="True"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         BorderBrush="{StaticResource LineBrush}" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="运行环境" Style="{StaticResource SectionTitle}" />
                                <ListBox x:Name="DiagnosticsList" BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Key}" Foreground="#FF6B7A8D" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="重新自检" Style="{StaticResource PlainButton}" Click="OnRefreshClick" />
                                    <Button Content="打开配置目录" Style="{StaticResource PlainButton}" Click="OnOpenConfigFolder" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="SelfTestDetails" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
